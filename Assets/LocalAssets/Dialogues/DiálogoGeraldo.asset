  - name: Geraldo de Revilla (2) (Pregunta)
    editorNote: Pregunta
    speakerName: Geraldo de Revilla
    portrait: {fileID: 9072650324573024778, guid: a6b1ccf02a4c72644a8ae62cf0dc17af, type: 3}
    text: "\xBFLo has visto?"
